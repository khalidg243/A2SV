arr_length , x = map(int,input().split())

arr = list(map(int,input().split()))

arr.sort()
if x == 0 and arr[0] == 1:
    print(-1)
elif x == 0 and arr[0] > 1:
    print(arr[0]-1)
elif arr_length == x:
    print(arr[x-1])
elif x > arr_length or arr[x] == arr[x - 1]:
    print(-1)
else:
    print(arr[x-1])
