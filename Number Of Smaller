arr1_length , arr2_length = map(int,input().split())

arr1 = list(map(int,input().split()))
arr2 = list(map(int,input().split()))

i = j = cnt = 0
res=[]
while i < arr1_length and j < arr2_length :
    if arr1[i] >= arr2[j]:
        res.append(cnt)
        j += 1
    else:
        i += 1
        cnt += 1

if i < arr1_length:
    res.extend([cnt]*(arr1_length-i))    
else:
    res.extend([cnt]*(arr2_length-j))     

print(" ".join(map(str,res)))   
    
