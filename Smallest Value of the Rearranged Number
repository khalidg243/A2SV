class Solution:
    def smallestNumber(self, num: int) -> int:
        arr=[]
        if num < 0:
            temp= num * -1
            while temp > 0 :
                arr.append(temp%10)
                temp =  temp//10
            arr.sort(reverse = True)
            return (int("".join(map(str, arr))))*-1
        elif num > 0:
            temp= num
            while temp > 0 :
                arr.append(temp%10)
                temp =  temp//10
            arr.sort()
            if arr[0] == 0:
                i=1
                while arr[i] == 0:
                    i+=1
                arr[i] , arr[0] = arr[0] , arr[i]
            return (int("".join(map(str, arr))))
        else:
            return 0
