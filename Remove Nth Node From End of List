# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def removeNthFromEnd(self, head: Optional[ListNode], n: int) -> Optional[ListNode]:
        if not head:
            return None
        
        dummy = ListNode(-1,head)
        i = 0
        curr = dummy
        seeker = dummy

        while curr and i < n+1:    
            curr = curr.next 
            i += 1

        while curr:
            curr = curr.next
            seeker = seeker.next
        else:
            if seeker.next:
                seeker.next = seeker.next.next

        
        return dummy.next
