"""
# Definition for a Node.
class Node:
    def __init__(self, val, prev, next, child):
        self.val = val
        self.prev = prev
        self.next = next
        self.child = child
"""

class Solution:
    def branch(self, node: Node):
        nxt = node.next
        node.next = node.child
        node.child.prev = node
        temp = node.child
        while temp.next:
            temp = temp.next
        
        temp.next = nxt
        if nxt:
            nxt.prev = temp
    def flatten(self, head: 'Optional[Node]') -> 'Optional[Node]':
        temp = head
        while temp:
            if temp.child:
                self.branch(temp)
                temp.child = None
            
            temp = temp.next
            

        return head
        
