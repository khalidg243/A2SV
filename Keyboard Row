class Solution:
    def findWords(self, words: List[str]) -> List[str]:
        row1 = set("qwertyuiop")
        row2 = set("asdfghjkl")
        row3 = set("zxcvbnm")
        res=[]
        for word in words:
            temp_word=set(word.lower())
            if temp_word.issubset(row1) or temp_word.issubset(row2) or temp_word.issubset(row3):
               res.append(word) 

        return res

