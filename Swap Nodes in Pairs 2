# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def swapPairs(self, head: Optional[ListNode]) -> Optional[ListNode]:
        if not head or not head.next:
            return head

        dummy = ListNode(-1 , head)
    
        def swap (prev , node1 , node2):
            if not node1 or not node2:
                return dummy.next
            
            end = node2.next
            prev.next = node2
            node2.next = node1
            node1.next = end

            if not end or not end.next:
                return dummy.next

            return swap(node1, end, end.next)

        return swap(dummy , head, head.next)
