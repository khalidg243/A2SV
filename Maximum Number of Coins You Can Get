class Solution:
    def maxCoins(self, piles: List[int]) -> int:
        piles.sort()
        piles.reverse()
        total_coins = 0
        cnt=0
        i=1
        length = len(piles)
        while i < length:
            total_coins += piles[i]
            piles.pop()
            i+=2
            length -= 1
        return total_coins
