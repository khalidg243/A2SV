class Solution:
    def areAlmostEqual(self, s1: str, s2: str) -> bool:
        indicies=[]
        for i in range(len(s1)):
            if s1[i]!=s2[i]:
                indicies.append(i)
        
        if len(indicies) == 2:
            i , j = indicies
            return s1[i]==s2[j] and s2[i]==s1[j]
        
        return len(indicies)==0
            
