class Solution:
    def reductionOperations(self, nums: List[int]) -> int:
        dictionary = {}
        nums.sort()
        smallest_seen = nums[-1]

        for num in nums:
            dictionary[num] = dictionary.get(num, 0) + 1
        
        total = 0
        distinct = 0
        for num in dictionary:
            total += distinct * dictionary[num]
            distinct += 1

        return total 
