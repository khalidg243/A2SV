class Solution:
    def matchPlayersAndTrainers(self, players: List[int], trainers: List[int]) -> int:
        left = right = cnt = 0
        players.sort()
        trainers.sort()
        while left < len(players) and right < len(trainers):
            if players[left] <= trainers[right]:
                cnt += 1 
                left += 1
                right += 1
            else:
                right += 1
        
        return cnt
