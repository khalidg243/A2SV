class Solution:
    def maxArea(self, height: List[int]) -> int:
        left = 0 
        right = len(height) - 1
        max_capacity = right * min(height[left] , height[right])
        while left < right:
            if  (right - left) * min(height[left] , height[right]) > max_capacity:
                max_capacity = (right - left) * min(height[left] , height[right])
            if height[left] <= height[right]:
                left += 1
            else:
                right -= 1
        return max_capacity
