from typing import Counter

class Solution:
    #Function to check if a is a subset of b.
    def isSubset(self, a, b):
        # Your code here 
        ca = Counter(a)
        cb = Counter(b)
        for num in b:
            if cb[num] > ca[num]:
                return False
        return True
        
    
    
