class DataStream:

    def __init__(self, value: int, k: int):
        self.queue = deque()
        self.val = value
        self.k = k
        self.cnt = 0
    def consec(self, num: int) -> bool:
        self.queue.append(num)
        if num == self.val:
            self.cnt += 1
        else:
            self.cnt = 0
        if self.cnt >= self.k:
            return True
        else:
            return False
        


