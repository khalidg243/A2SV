# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def addTwoNumbers(self, l1: Optional[ListNode], l2: Optional[ListNode]) -> Optional[ListNode]:
        l1_curr = l1
        l2_curr = l2

        dummy = ListNode(-1,None)
        curr = dummy
        remainder = 0 
        while l1_curr and l2_curr:
            x = l1_curr.val + l2_curr.val + remainder
            if x > 9 :
                remainder = 1
                x -= 10
            else:
                remainder = 0
            curr.next = ListNode(x,None)
            l1_curr = l1_curr.next
            l2_curr = l2_curr.next
            curr = curr.next

        while l1_curr:
            x = l1_curr.val + remainder
            if x > 9 :
                remainder = 1
                x -= 10
            else:
                remainder = 0
            curr.next = ListNode(x,None)
            l1_curr = l1_curr.next
            curr = curr.next

        while l2_curr:           
            x = l2_curr.val + remainder
            if x > 9 :
                remainder = 1
                x -= 10
            else:
                remainder = 0
            curr.next = ListNode(x,None)
            l2_curr = l2_curr.next
            curr = curr.next                   
                 
        if remainder == 1:
                tail = ListNode(1,None)
                curr.next = tail
        
        return dummy.next
            
