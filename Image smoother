class Solution:
    def imageSmoother(self, img: List[List[int]]) -> List[List[int]]:
        smoothed_img=[[0]*len(img[0])for i in range(len(img))]

        def calculation(r,c):
            total=0
            cnt=0
            for i in range(-1,2):
                for j in range(-1,2):
                    if r+i >=0 and r+i<len(img) and j+c<len(img[0]) and j+c >=0:
                        total+= img[r+i][j+c]
                        cnt+=1
            return total//cnt


        for row_idx in range(len(img)):
            for col_idx in range(len(img[0])):
                smoothed_img[row_idx][col_idx]=calculation(row_idx,col_idx)

        return smoothed_img

