# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def partition(self, head: Optional[ListNode], x: int) -> Optional[ListNode]:
        small_d = ListNode(-1)
        large_d = ListNode(-1)

        small = small_d
        large = large_d

        curr = head

        while curr:
            if curr.val < x:
                small.next = curr
                small = small.next
            else:
                large.next = curr
                large = large.next
            curr = curr.next
        
        small.next = large_d.next
        large.next = None

        return small_d.next
