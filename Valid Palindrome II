class Solution:
    def validPalindrome(self, s: str) -> bool:
        
        def isPalindrome(left: int , right: int) ->bool:
            while left < right:
                if s[left] != s[right]:
                    return False
                right -= 1
                left += 1
            return True
        
        left , right = 0 , len(s) - 1 

        while left < right:
                if s[left] != s[right]:
                    return isPalindrome(left, right-1) or isPalindrome(left + 1, right)
                right -= 1
                left += 1
        return True
