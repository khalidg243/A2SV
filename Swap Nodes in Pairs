# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def swapPairs(self, head: Optional[ListNode]) -> Optional[ListNode]:
        dummy = ListNode(-1 , head)
        prev = dummy
        temp = head

        while temp and temp.next:
            start = prev
            prev = prev.next
            temp = temp.next
            end = temp.next
            start.next = temp
            temp.next = prev
            prev.next = end
            temp = end
        
        return dummy.next
