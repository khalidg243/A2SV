N=int(input())
words=[]
shortened_words=[]
for i in range(N):
    word=input()
    words.append(word)
    if len(word)>10:
        shortened_word=word[0]+str(len(word)-2)+word[-1]
        shortened_words.append(shortened_word)
    else:
        shortened_words.append(word)
for shortened_word in shortened_words:
    print(shortened_word)
