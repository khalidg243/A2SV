class Solution:
    def nextGreaterElements(self, nums: List[int]) -> List[int]:
        stack = []
        ans = [-1] * len(nums)

        for i, num in enumerate(nums):
            while stack and num > stack[-1][1]:
                pair = stack.pop()
                ans[pair[0]] = num
            stack.append([i,num])

        for i, num in enumerate(nums):
            while stack and num > stack[-1][1]:
                pair = stack.pop()
                ans[pair[0]] = num
            stack.append([i,num])
        
        return ans
