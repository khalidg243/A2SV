# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def pairSum(self, head: Optional[ListNode]) -> int:
        arr = []
        temp = head
        while temp:
            arr.append(temp.val)
            temp = temp.next
        
        l , r = 0 , len(arr) - 1
        max_seen = 0
        while l < r:
            max_seen = max(max_seen, (arr[l] + arr[r]))
            l += 1
            r -= 1
        
        return max_seen
