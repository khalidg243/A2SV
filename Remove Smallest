N= int(input())

for _ in range(N):
    arr_length = int(input())
    arr = list(map(int,input().split()))
    
    arr = sorted(set(arr))
    cnt = 0

    for i in range(len(arr)-1):
        if arr[i]+1 == arr[i+1]:
            cnt += 1
    
    if len(arr) - cnt > 1:
        print("NO")
    else:
        print("YES")
    
