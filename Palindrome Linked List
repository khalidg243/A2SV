# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def isPalindrome(self, head: Optional[ListNode]) -> bool:
        slow = fast = head

        while fast and fast.next:
            slow = slow.next
            fast = fast.next.next
        
        prev = None
        curr = slow
        while curr:
            nxt_node = curr.next
            curr.next = prev
            prev = curr
            curr = nxt_node
        
        start = head
        end = prev
        while start and end:
            if start.val != end.val:
                return False
            start = start.next
            end = end.next
        return True

