class Solution:
    def removeElement(self, nums: List[int], val: int) -> int:
        left = 0
        right = len(nums) - 1
        cnt = 0 
        if right == 0:
            if nums[0] == val:
                return 0
            else:
                return 1
        while left <= right:
            if nums[left] == val:
                nums[left], nums[right] = nums[right], nums[left]
                right -= 1
            else:
                left += 1
                cnt += 1

        return cnt
